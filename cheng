<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>芋泥＆bi8bo - 专属代跑</title>
    <style>
        /* --- 基础设置 --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: linear-gradient(180deg, #e0f2f1 0%, #b2dfdb 50%, #80cbc4 100%);
            color: #37474f;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* 滚动条美化 */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 150, 136, 0.3);
            border-radius: 10px;
        }

        /* --- 游动的小鱼 (固定在左侧) --- */
        #swimming-fish {
            position: fixed;
            left: 15px;
            top: 20%;
            width: 50px;
            height: 50px;
            z-index: 100;
            transition: transform 0.3s ease;
            /* 简单的SVG鱼 */
            background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><path d="M10,50 C30,20 60,20 80,50 C60,80 30,80 10,50 Z" fill="%23ffb74d"/><circle cx="70" cy="45" r="5" fill="%23333"/><path d="M80,50 L95,30 L90,50 L95,70 Z" fill="%23ffb74d"/></svg>') no-repeat center center;
            background-size: contain;
            animation: fishFloat 3s infinite ease-in-out;
        }

        @keyframes fishFloat {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(-5deg); }
        }

        /* --- 气泡特效 --- */
        .bubbles {
            position: fixed;
            bottom: -20px;
            width: 100%;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
        }
        .bubble {
            position: absolute;
            bottom: 0;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            animation: rise 8s infinite;
        }
        @keyframes rise {
            0% { transform: translateY(0) scale(1); opacity: 1; }
            100% { transform: translateY(-100vh) scale(1.5); opacity: 0; }
        }

        /* --- 页面区块通用 --- */
        .section {
            min-height: 100vh;
            padding: 60px 20px 100px 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            z-index: 10;
        }

        /* 毛玻璃卡片 */
        .glass-card {
            width: 100%;
            max-width: 380px;
            background: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 24px;
            padding: 30px 20px;
            box-shadow: 0 8px 32px rgba(0, 77, 64, 0.1);
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        }

        /* 滚动触发动画 */
        .section.visible .glass-card {
            opacity: 1;
            transform: translateY(0);
        }

        /* --- 区域1：主页 --- */
        .avatar {
            width: 80px;
            height: 80px;
            background: #e0e0e0;
            border-radius: 50%;
            margin: 0 auto 15px;
            border: 3px solid #fff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            /* 这里换成你的头像 */
            background-image: url('https://api.dicebear.com/7.x/adventurer/svg?seed=Yuni');
            background-size: cover;
        }
        .name {
            text-align: center;
            font-size: 24px;
            font-weight: 800;
            color: #00695c;
            margin-bottom: 5px;
        }
        .contact {
            text-align: center;
            font-size: 14px;
            background: #b2dfdb;
            color: #00695c;
            padding: 4px 12px;
            border-radius: 20px;
            display: inline-block;
            margin: 0 auto 15px;
            font-weight: bold;
        }
        .slogan {
            text-align: center;
            font-size: 14px;
            line-height: 1.6;
            color: #455a64;
            background: rgba(255,255,255,0.5);
            padding: 10px;
            border-radius: 12px;
        }

        /* --- 区域2：下单必看 (手风琴效果) --- */
        .section-title {
            font-size: 20px;
            font-weight: bold;
            color: #00695c;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .accordion {
            background: rgba(255, 255, 255, 0.6);
            border-radius: 16px;
            margin-bottom: 15px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.8);
            transition: all 0.3s ease;
        }

        .accordion-header {
            padding: 15px 20px;
            font-size: 16px;
            font-weight: bold;
            color: #00796b;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            user-select: none;
        }
        
        /* 点击时的加号旋转动画 */
        .accordion-header::after {
            content: '+';
            font-size: 20px;
            transition: transform 0.3s ease;
        }
        .accordion.active .accordion-header::after {
            transform: rotate(45deg);
        }

        .accordion-content {
            max-height: 0;
            padding: 0 20px;
            overflow: hidden;
            transition: max-height 0.4s ease, padding 0.4s ease;
            font-size: 14px;
            line-height: 1.8;
            color: #37474f;
        }
        .accordion.active .accordion-content {
            max-height: 500px; /* 足够高以容纳内容 */
            padding: 0 20px 20px 20px;
        }

        /* 高亮重点文字 */
        .highlight { color: #d32f2f; font-weight: bold; }
        .mark { background: #fff59d; padding: 0 4px; border-radius: 4px; }

        /* --- 区域3：xyt展示 --- */
        .link-card {
            display: block;
            text-decoration: none;
            background: rgba(255, 255, 255, 0.7);
            padding: 18px 20px;
            border-radius: 16px;
            margin-bottom: 15px;
            color: #00695c;
            font-weight: bold;
            font-size: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: transform 0.2s, background 0.2s;
            border: 1px solid rgba(255, 255, 255, 0.9);
        }
        .link-card:hover {
            transform: translateX(5px);
            background: rgba(255, 255, 255, 0.9);
        }
        .link-card::after {
            content: '→';
            color: #009688;
        }

        /* --- 底部导航 --- */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 65px;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            display: flex;
            justify-content: space-around;
            align-items: center;
            z-index: 200;
            box-shadow: 0 -2px 20px rgba(0, 77, 64, 0.08);
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            padding-bottom: env(safe-area-inset-bottom);
        }

        .nav-item {
            font-size: 12px;
            color: #78909c;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            transition: color 0.3s;
        }
        .nav-item.active { color: #009688; font-weight: bold; }
        .nav-icon { font-size: 20px; }

    </style>
</head>
<body>

    <!-- 游动的小鱼 -->
    <div id="swimming-fish"></div>

    <!-- 气泡特效容器 -->
    <div class="bubbles" id="bubbles"></div>

    <!-- 区域1：主页 -->
    <section class="section" id="section1">
        <div class="glass-card">
            <div class="avatar"></div>
            <div class="name">芋泥＆bi8bo</div>
            <div style="text-align: center;"><div class="contact">联系：kkk099562</div></div>
            <div class="slogan">
                有事dd~随缘在线<br>
                (没回就是在睡觉 💤)
            </div>
        </div>
    </section>

    <!-- 区域2：下单必看 -->
    <section class="section" id="section2">
        <div class="glass-card" style="padding-bottom: 15px;">
            <div class="section-title">📋 下单必看</div>
            
            <!-- 模块1 -->
            <div class="accordion">
                <div class="accordion-header">关于代代 🐟</div>
                <div class="accordion-content">
                    • 已成年（请假会提前告知并给予补偿）<br>
                    • 手脚干净，不会动号上装扮（干饭需换盆）<br>
                    • 仅支持<span class="highlight">先付后跑</span><br>
                    • 支持预约/定尾<br>
                    • 安卓/ios全渠🉑接（有些渠道不经常接，请给我时间更新）
                </div>
            </div>

            <!-- 模块2 -->
            <div class="accordion">
                <div class="accordion-header">我会做的 🛠️</div>
                <div class="accordion-content">
                    ✅ 上下号告知<br>
                    ✅ 跑前跑后截图<br>
                    ✅ 小作文汇报<br>
                    ✅ 活动通知
                </div>
            </div>

            <!-- 模块3 -->
            <div class="accordion">
                <div class="accordion-header">下单须知 ⚠️</div>
                <div class="accordion-content" style="font-size: 13px;">
                    • 下单请先提供渠道及所需要求<br>
                    • <span class="highlight">❌防沉迷未成年</span><br>
                    • 预约需支付20r定金，跑单不退<br>
                    • 支持定尾，各50%，季节中途补尾款<br>
                    • 非代代原因中止，不退全款<br>
                    • 换复刻/红点/互心请提前告知<br>
                    • 送心任务🈚指定好友＋代代好友单删完成<br>
                    • 默认1-3好友位<br>
                    • 满加成开跑<br>
                    • 包周7天，包月30天，包年365天
                </div>
            </div>
        </div>
    </section>

    <!-- 区域3：xyt展示 -->
    <section class="section" id="section3">
        <div class="glass-card">
            <div class="section-title">📸 信誉图展示 (xyt)</div>
            <!-- 这里的 href 换成你的 WPS 分享链接 -->
            <a href=" " class="link-card" target="_blank">模块一：有翼区域</a >
            <a href="#" class="link-card" target="_blank">模块二：无翼区域</a >
            <a href="#" class="link-card" target="_blank">模块三：无翼献祭</a >
        </div>
    </section>

    <!-- 底部导航 -->
    <nav class="bottom-nav">
        <a href="#section1" class="nav-item active">
            <span class="nav-icon">🏠</span>
            <span>主页</span>
        </a >
        <a href="#section2" class="nav-item">
            <span class="nav-icon">📋</span>
            <span>下单必看</span>
        </a >
        <a href="#section3" class="nav-item">
            <span class="nav-icon">📸</span>
            <span>信誉图</span>
        </a >
    </nav>

    <script>
        // --- 1. 初始化气泡特效 ---
        const bubblesContainer = document.getElementById('bubbles');
        for (let i = 0; i < 15; i++) {
            const bubble = document.createElement('div');
            bubble.classList.add('bubble');
            // 随机大小、位置、动画时长
            const size = Math.random() * 20 + 10;
            bubble.style.width = `${size}px`;
            bubble.style.height = `${size}px`;
            bubble.style.left = `${Math.random() * 100}%`;
            bubble.style.animationDuration = `${Math.random() * 5 + 5}s`;
            bubble.style.animationDelay = `${Math.random() * 5}s`;
            bubblesContainer.appendChild(bubble);
        }

        // --- 2. 区域进入视口时的渐显动画 ---
        const sections = document.querySelectorAll('.section');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    // 更新底部导航状态
                    updateNav(entry.target.id);
                }
            });
        }, { threshold: 0.5 }); // 页面露出一半时触发

        sections.forEach(section => observer.observe(section));

        // --- 3. 手风琴交互逻辑 ---
        const accordions = document.querySelectorAll('.accordion');
        accordions.forEach(acc => {
            const header = acc.querySelector('.accordion-header');
            header.addEventListener('click', () => {
                // 点击时，关闭其他已展开的（如果希望只开一个的话，把下面两行注释删掉）
                // accordions.forEach(item => {
                //     if (item !== acc) item.classList.remove('active');
                // });
                // 切换自身的状态
                acc.classList.toggle('active');
            });
        });

        // --- 4. 小鱼游动交互 (监听滚动) ---
        let lastScrollY = window.scrollY;
        const fish = document.getElementById('swimming-fish');
        
        window.addEventListener('scroll', () => {
            const currentScrollY = window.scrollY;
            
            if (currentScrollY > lastScrollY) {
                // 向下滚动，鱼头朝下 (旋转180度)
                fish.style.transform = 'rotate(180deg)';
            } else {
                // 向上滚动，鱼头朝上 (恢复初始)
                fish.style.transform = 'rotate(0deg)';
            }
            
            lastScrollY = currentScrollY;
        });

        // 简单修复：向上滚的时候加一点倾斜，显得生动
        let scrollTimer;
        window.addEventListener('scroll', () => {
            clearTimeout(scrollTimer);
            fish.style.transform += ' scaleX(-1)'; // 调整小鱼面朝右或左
            scrollTimer = setTimeout(() => {
                fish.style.transform = fish.style.transform.replace(' scaleX(-1)', '');
            }, 150);
        });

        // --- 5. 底部导航高亮更新 ---
        function updateNav(id) {
            document.querySelectorAll('.nav-item').forEach(nav => {
                nav.classList.remove('active');
                if(nav.getAttribute('href') === `#${id}`) {
                    nav.classList.add('active');
                }
            });
        }
    </script>
</body>
</html>
