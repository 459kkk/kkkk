<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>温馨排版 - 占位版</title>
    <style>
        /* 基础重置 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            overflow: hidden;
            font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
        }

        /* 整体背景容器 */
        .app-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            /* 【替换位置1】这里换成你的插画背景图 */
            background-color: #a4c79e; 
            background-image: linear-gradient(135deg, #b4d6b0 0%, #88b383 100%);
            background-size: cover;
            background-position: center;
        }

        /* 毛玻璃卡片 */
        .glass-card {
            width: 82%;
            max-width: 320px;
            padding: 45px 20px;
            /* 采用深色半透明，模仿原图中偏灰绿的质感 */
            background: rgba(70, 90, 70, 0.35);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 80px; /* 给底部导航留出空间 */
        }

        /* --- 以下为占位符样式 --- */

        /* 【替换位置2】头像占位 */
        .avatar-box {
            width: 85px;
            height: 85px;
            border-radius: 50%;
            border: 3px solid rgba(255, 255, 255, 0.9);
            background-color: rgba(255, 255, 255, 0.2);
            margin-bottom: 20px;
        }

        /* 【替换位置3】姓名占位 */
        .name-box {
            width: 120px;
            height: 24px;
            background-color: rgba(255, 255, 255, 0.7);
            border-radius: 6px;
            margin-bottom: 18px;
        }

        /* 【替换位置4】学校信息占位 */
        .info-box {
            width: 200px;
            height: 12px;
            background-color: rgba(255, 255, 255, 0.4);
            border-radius: 4px;
            margin-bottom: 8px;
        }
        .info-box.short {
            width: 160px;
            margin-bottom: 25px;
        }

        /* 【替换位置5】欢迎语占位 */
        .welcome-box {
            width: 180px;
            height: 12px;
            background-color: rgba(255, 255, 255, 0.4);
            border-radius: 4px;
            margin-bottom: 10px;
        }
        .welcome-box.short {
            width: 140px;
            margin-bottom: 30px;
        }

        /* 【替换位置6】按钮占位 */
        .enter-btn-box {
            width: 140px;
            height: 45px;
            border-radius: 25px;
            border: 2px solid rgba(255, 255, 255, 0.9);
            background: transparent;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        /* 按钮里的文字占位 */
        .btn-text-box {
            width: 50px;
            height: 16px;
            background-color: rgba(255, 255, 255, 0.8);
            border-radius: 4px;
        }

        /* --- 底部导航栏 --- */
        .bottom-nav {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 75px;
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-top-left-radius: 25px;
            border-top-right-radius: 25px;
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding-bottom: env(safe-area-inset-bottom); 
            box-shadow: 0 -2px 15px rgba(0, 0, 0, 0.05);
        }

        /* 【替换位置7】导航项占位 */
        .nav-item-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }
        .nav-icon-box {
            width: 24px;
            height: 24px;
            background-color: #888; /* 灰色图标占位 */
            border-radius: 6px;
            opacity: 0.5;
        }
        .nav-text-box {
            width: 30px;
            height: 10px;
            background-color: #888; /* 灰色文字占位 */
            border-radius: 4px;
            opacity: 0.5;
        }
        
        /* 让当前选中的导航高亮一点 */
        .nav-item-box.active .nav-icon-box,
        .nav-item-box.active .nav-text-box {
            opacity: 0.9;
            background-color: #4a6b4a; 
        }

    </style>
</head>
<body>

    <div class="app-container">
        
        <!-- 居中毛玻璃卡片 -->
        <div class="glass-card">
            <!-- 头像 -->
            <div class="avatar-box"></div>
            
            <!-- 姓名 -->
            <h1 class="name">芋泥＆bi8bo</h1>
            
            <!-- 信息段 1 -->
            <div class="info-box"></div>
            <div class="info-box short"></div>
            
            <!-- 信息段 2 -->
            <div class="welcome-box"></div>
            <div class="welcome-box"></div>
            <div class="welcome-box short"></div>
            
            <!-- 按钮 -->
            <div class="enter-btn-box">
                <div class="btn-text-box"></div>
            </div>
        </div>

        <!-- 底部导航栏 -->
        <nav class="bottom-nav">
            <div class="nav-item-box active">
                <div class="nav-icon-box"></div>
                <div class="nav-text-box"></div>
            </div>
            <div class="nav-item-box">
                <div class="nav-icon-box"></div>
                <div class="nav-text-box"></div>
            </div>
            <div class="nav-item-box">
                <div class="nav-icon-box"></div>
                <div class="nav-text-box"></div>
            </div>
        </nav>

    </div>

</body>
</html>
